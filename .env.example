# ─────────────────────────────────────────────────────────────
# The Passion Discovery Engine — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real keys. (.gitignore already excludes it.)
#
# NOTE: The current prototype runs fully with a built-in MOCK AI and
# browser-local persistence, so NONE of these are required to demo it.
# They become required when the real Gemini + Supabase backend is wired in.
# ─────────────────────────────────────────────────────────────

# ── Public (safe to expose to the browser) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=

# ── Server-only (MUST stay out of the browser) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider — all AI calls happen server-side only
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=700

APP_ORIGIN=http://localhost:3000
NODE_ENV=development
