# ─────────────────────────────────────────────────────────────
# The Passion Discovery Engine — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real keys. (.gitignore already excludes it.)
#
# NOTE: The prototype runs fully with a built-in MOCK AI and browser-local
# persistence, so NONE of these are required to demo it. They become required
# when the real Supabase + Gemini backend is enabled. Every backend path
# validates its config at runtime and fails with a clear error when missing.
# ─────────────────────────────────────────────────────────────

# ── Public (safe to expose to the browser) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=

# ── Server-only (MUST stay out of the browser) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider — all AI calls happen server-side only ──
# When GEMINI_API_KEY is empty the /api/ai route falls back to the
# deterministic mock manager, so demos never break.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=700

# ── Rate limiting (Upstash Redis). Omit to disable (dev/prototype). ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Misc ──
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development
